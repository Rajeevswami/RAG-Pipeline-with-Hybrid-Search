# Copy to .env. OpenAI embeddings are the default; set an API key to index documents.
APP_NAME="Atlas | Internal Knowledge"
ENVIRONMENT=development
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Answer model: openai (GPT-4o family) or anthropic (Claude Sonnet family)
LLM_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514
REQUEST_TIMEOUT_SECONDS=60

# Dense retrieval
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# Optional local embedding model (install requirements-local.txt first).
# For Docker Compose also set INSTALL_LOCAL_MODELS=true and rebuild the api image.
# EMBEDDING_PROVIDER=sentence-transformers
# LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# LOCAL_EMBEDDING_CHUNK_SIZE_TOKENS=160
# LOCAL_EMBEDDING_CHUNK_OVERLAP_TOKENS=32
# INSTALL_LOCAL_MODELS=true

# Blank QDRANT_URL uses persistent embedded Qdrant for one-process local development.
# Docker Compose points this at its Qdrant service automatically.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=company_docs
QDRANT_PATH=data/qdrant
SQLITE_PATH=data/rag.sqlite3

# Retrieval / indexing
CHUNK_SIZE_TOKENS=420
CHUNK_OVERLAP_TOKENS=64
RETRIEVAL_CANDIDATES=30
DEFAULT_TOP_K=6
MAX_TOP_K=10
RRF_K=60
DENSE_WEIGHT=0.55
LEXICAL_WEIGHT=0.45
MIN_CITATION_QUOTE_CHARS=12
MAX_UPLOAD_MB=25

# Optional learned reranker (install requirements-reranker.txt first).
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
